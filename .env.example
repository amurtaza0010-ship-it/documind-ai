# =============================================================
#  DocuMind AI v2 — Environment Configuration
# =============================================================

# ── REQUIRED ──────────────────────────────────────────────
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── FREE MODELS on OpenRouter (pick one) ──────────────────
# deepseek/deepseek-chat-v3-0324:free       ← best free model (recommended)
# meta-llama/llama-3.3-70b-instruct:free    ← very capable
# google/gemini-2.0-flash-exp:free          ← fast
# mistralai/mistral-7b-instruct:free        ← lightweight
# qwen/qwen3-8b:free                        ← good multilingual
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# ── APP ───────────────────────────────────────────────────
DEBUG=false
MAX_FILE_SIZE_MB=50

# ── RAG TUNING ────────────────────────────────────────────
CHUNK_SIZE=1500
CHUNK_OVERLAP=300
RETRIEVAL_K=10
RERANKER_TOP_N=5

# ── LLM ───────────────────────────────────────────────────
# Lower max_tokens if you hit OpenRouter 402 credit errors (default: 1024)
MAX_TOKENS=1024
TEMPERATURE=0.1
